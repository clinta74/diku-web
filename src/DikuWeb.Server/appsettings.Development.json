{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  // The builder assist talks to the Ollama container on this machine
  // (tools/ollama/README.md). Development only, and on by default here so a dev server can drive
  // the local model without extra setup; production leaves Assist:Enabled unset, which is off.
  //
  // The model name matters: gemma3:12b would answer to this and would answer with a 4096-token
  // window, silently truncating the canon. Point it at the derived model or at nothing.
  "Assist": {
    "Enabled": true,
    "BaseUrl": "http://localhost:11434",
    "Model": "dikuweb-builder"
  },
  "ConnectionStrings": {
    // Matches the docker-compose.yml defaults. Local development only, and not a secret.
    // Real deployments supply this via environment variables or user-secrets.
    "DikuWeb": "Host=localhost;Port=5432;Database=dikuweb;Username=dikuweb;Password=dikuweb_dev_only"
  }
}

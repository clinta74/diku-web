{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Sessions": {
    // How many characters one account may have in the world at the same time. Each holds an
    // open SSE connection and a ring buffer, so this is a resource bound, not a game rule.
    "MaxConcurrentCharactersPerAccount": 3,

    // How many an account may have at all, played or not. A roster limit rather than a resource
    // one - a character that is not in the world costs a row. Deleted ones do not count.
    "MaxCharactersPerAccount": 8
  },
  "ConnectionStrings": {
    "DikuWeb": ""
  }
}

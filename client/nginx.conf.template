# Minimal nginx configuration for DikuWeb SPA + API proxy
# Serves React app on / and proxies /api to backend
#
# A template, not a finished config. The nginx image's entrypoint runs envsubst over everything in
# /etc/nginx/templates, so ${BACKEND_ORIGIN} below is filled in at container start - which is what
# lets one published image serve a compose file that named its API something other than `web`.
# Only ${BACKEND_ORIGIN} and ${NGINX_LOCAL_RESOLVERS} are substituted; nginx's own $variables are
# left alone, because envsubst only replaces names that exist in the environment.

# No `user` directive: the container already runs as nginx-app (see Dockerfile), and the directive
# is only meaningful to a master process running as root - nginx warns and ignores it otherwise.
worker_processes auto;
error_log /var/log/nginx/error.log warn;

# /var/run is root-owned, so a non-root master cannot write its pid file there.
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # nginx's stock mime.types predates the web app manifest, so without this the manifest is
    # served as application/octet-stream and the app is not installable (MOBILE.md M5).
    types {
        application/manifest+json webmanifest;
    }

    # One quote per side. These were doubled - `''$remote_addr` - which nginx rejects outright as
    # `unexpected "$"`, so the container never started at all.
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    client_max_body_size 20M;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1000;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/javascript
               application/x-javascript application/xml+rss
               application/javascript application/json
               application/manifest+json image/svg+xml;

    # Deliberately not an `upstream` block. nginx resolves an upstream host once, at startup, and
    # refuses to start at all if it does not resolve - so the UI container could not boot unless
    # the API was already up, and died on any compose file that named the API something else.
    # Passing the origin through a variable defers the lookup to request time instead, which is
    # what makes a resolver necessary.
    #
    # 127.0.0.11 is Docker's embedded DNS, which every compose stack gets because compose always
    # creates a user-defined network. Set DNS_RESOLVER if that is ever not true.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    server {
        # so_keepalive is defence in depth for the SSE stream, and the numbers are deliberate:
        # probe after 30s of silence, again every 10s, give up after 3 failures - so a client that
        # vanished without closing its socket is noticed in about a minute rather than whenever the
        # kernel finishes retransmitting.
        #
        # It is NOT the mechanism. The client sends its own heartbeat and the server reaps sessions
        # that stop arriving, because nginx is not always in front and because knowing a player is
        # there beats inferring it from a socket. Measured before this line existed: a client whose
        # network was severed held a live session for sixteen and a half minutes through nginx and
        # sixteen and a half minutes without it - the proxy made no difference at all, because its
        # own writes were succeeding into a send buffer exactly as Kestrel's were (PLAN.md §11).
        listen 80 default_server so_keepalive=30s:10s:3;
        listen [::]:80 default_server so_keepalive=30s:10s:3;
        server_name _;

        root /usr/share/nginx/html;
        index index.html;

        # Health check endpoint (for docker healthcheck)
        location /health {
            access_log off;
            return 200 "OK\n";
            add_header Content-Type text/plain;
        }

        # The world import, which is the longest request the app makes.
        #
        # WorldImporter now sends entities to the loop in batches of 128, so the Reaches bundle's
        # 1005 entities cost about eight pulses rather than 1005 - a couple of seconds of loop time
        # plus the database work, where it used to be a little over four minutes. This block is what
        # made that four minutes survivable and is kept as headroom, not because the timeout is
        # expected to be reached: an import writes nothing to the response until it has finished, so
        # unlike the SSE stream below there is no traffic to keep proxy_read_timeout alive, and the
        # cost still scales with the size of the bundle.
        #
        # The apply phase runs on CancellationToken.None, so a proxy that does give up no longer
        # tears the import in half - it finishes server-side. That used to be the real hazard here: a
        # 504 at 60 seconds left every template applied, about a quarter of the rooms, not one exit
        # or spawner, and no report to say so.
        #
        # An exact-match location, so it wins over the /api/ prefix below without depending on
        # order. The proxy directives are duplicated rather than inherited, because sibling
        # locations do not inherit from each other and proxy_read_timeout does not accept a
        # variable - so the two blocks have to be kept in step by hand.
        location = /api/builder/import {
            set $backend "${BACKEND_ORIGIN}";
            proxy_pass $backend$request_uri;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $server_name;

            proxy_set_header Connection "";
            proxy_buffering off;
            proxy_request_buffering off;

            # Fifteen minutes. Far more than the batched path needs, deliberately: this is the one
            # request whose cost grows with the size of the world, and re-deploying a proxy is a
            # worse way to find that out than having the headroom already.
            proxy_connect_timeout 60s;
            proxy_send_timeout 900s;
            proxy_read_timeout 900s;
        }

        # API proxy - forward all /api requests to backend
        location /api/ {
            # Through a variable on purpose - see the resolver note above. The trailing $request_uri
            # is required once proxy_pass carries a variable, because nginx then stops appending the
            # matched path itself and would otherwise proxy every /api/... call to the API's root.
            set $backend "${BACKEND_ORIGIN}";
            proxy_pass $backend$request_uri;
            proxy_http_version 1.1;
            
            # Preserve original request info
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $server_name;
            
            # For Server-Sent Events (game stream)
            proxy_set_header Connection "";
            proxy_buffering off;
            proxy_request_buffering off;
            
            # Timeouts
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
        }

        # SPA routing: all requests not matching files/dirs go to index.html
        location / {
            # Try to serve files and directories, else index.html
            try_files $uri $uri/ /index.html;
            
            # Cache static assets (with hash in filename via Vite)
            expires 1y;
            add_header Cache-Control "public, immutable";
        }

        # Don't cache HTML files (so updates are picked up)
        location = /index.html {
            expires -1;
            add_header Cache-Control "no-cache, no-store, must-revalidate";
        }

        # Security headers
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
}
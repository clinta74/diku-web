<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Muwbta.Playtest</RootNamespace>
  </PropertyGroup>

  <!--
    Domain only, and deliberately. The apparatus is a client: it speaks the same HTTP and SSE the
    browser speaks, so if it ever needs Engine or Server to work, that is a finding about the
    protocol rather than a reason to add a reference. Domain is here for the enums a plan names -
    CharacterPath, AccountRole - so a typo in a plan is a compile error rather than a 400 at
    runtime.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Muwbta.Domain\Muwbta.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Muwbta.Playtest.Tests" />
  </ItemGroup>

</Project>

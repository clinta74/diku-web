# DikuWeb Docker Compose Environment Configuration
# Copy to .env and update for your deployment

# ============================================================================
# Deployment Environment
# ============================================================================
# Environment: prod, staging, or dev
DIKUWEB_ENV=Production
# Image tag to deploy (e.g., v1.0.0, latest, main-abc123)
DIKUWEB_IMAGE_TAG=latest
# Container registry (ghcr.io for GitHub, docker.io for Docker Hub, etc.)
REGISTRY=ghcr.io
# Image repository path (e.g., your-org/diku-web)
IMAGE_REPO=your-org/diku-web

# ============================================================================
# Database Configuration
# ============================================================================
# Must be different from default in production!
POSTGRES_DB=dikuweb
POSTGRES_USER=dikuweb
POSTGRES_PASSWORD=change_me_in_production_12345

# Port mapping for PostgreSQL (dev/staging only; prod uses internal network)
POSTGRES_PORT=127.0.0.1:5432

# ============================================================================
# Frontend Configuration
# ============================================================================
# Port to expose the React frontend on (nginx reverse proxy)
CLIENT_PORT=80

# ============================================================================
# Backend API Configuration
# ============================================================================
# Logging level: Trace, Debug, Information, Warning, Error, Critical, None
LOG_LEVEL=Information

# Port for direct backend access (dev only; comment out to disable)
# Normally proxied through nginx, so this is optional
# WEB_DEBUG_PORT=127.0.0.1:5001

# ============================================================================
# Game Engine Configuration
# ============================================================================
# Maximum characters per account
MAX_CHARACTERS=5
# Maximum concurrent sessions in the game
MAX_SESSIONS=100
# Grace period before link-dead character is expelled (seconds)
LINKDEAD_GRACE=30
# Starting room for new characters (format: key@x.y.z)
STARTING_ROOM=hall@0.0.0

# ============================================================================
# Authentication & Session Configuration
# ============================================================================
# Session timeout in minutes (14 days = 20160)
SESSION_TIMEOUT=20160

# ============================================================================
# Admin Tools (DISABLED in production for security)
# ============================================================================
# Database access: use psql CLI instead
#   docker-compose exec postgres psql -U dikuweb -d dikuweb
# Or use your PostgreSQL client (pgAdmin, DBeaver, etc.)
#
# Adminer is disabled by default in docker-compose.yml (security risk)
# Uncomment in docker-compose.yml to enable for development only

# ============================================================================
# Optional: Swagger Documentation
# ============================================================================
# Enable Swagger/OpenAPI endpoints (false in production)
SWAGGER_ENABLED=false

# Local development environment variables.
# Copy to .env and adjust; docker-compose.yml reads these.
#
# The names are POSTGRES_*, matching the container's own variables, deploy.dev.conf, and the prod
# and NAS compose files. They used to be DB_* here and nowhere else, which failed silently: a .env
# written in the other dialect left compose falling back to its defaults, so Postgres initialised
# with a password nothing else in the project knew.

# Database. POSTGRES_PASSWORD must match the connection string in
# src/DikuWeb.Server/appsettings.Development.json, which is what the locally-run server uses.
#
# NOTE: Postgres reads POSTGRES_PASSWORD only when it initialises an empty data directory.
# Changing it against an existing `pgdata` volume does nothing until the volume is recreated
# (docker compose down -v) or the role is altered by hand:
#
#   docker exec -it dikuweb-postgres psql -U dikuweb -d dikuweb \
#     -c "ALTER ROLE dikuweb WITH PASSWORD 'the-new-one';"
POSTGRES_DB=dikuweb
POSTGRES_USER=dikuweb
POSTGRES_PASSWORD=dikuweb_dev_only

# Published on 127.0.0.1 only. Move POSTGRES_PORT if something else already holds 5432 - a
# natively installed Postgres usually does.
POSTGRES_PORT=5432
ADMINER_PORT=8080

# The AI assist container (docker compose --profile assist up -d) sizes itself from these. They
# stop mattering much with docker-compose.gpu.yml layered on, because the model is then resident
# on the card rather than being evaluated on the CPU.
OLLAMA_CPUS=4.0
OLLAMA_THREADS=4
OLLAMA_MEMORY=12g
